# =============================================================================
# NutriLog Next.js — Environment Variables
# Salin sebagai .env untuk lokal, atau isi di Vercel > Settings > Environment Variables
# =============================================================================

# Supabase Transaction Pooler (port 6543) — wajib untuk Vercel serverless
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase REST (untuk fitur migrasi data lama dari KV Store)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret — generate dari https://www.randomkeygen.com (Fort Knox level, 64+ karakter)
JWT_SECRET=change-this-to-a-random-64-char-string-do-not-use-this-default

# Password default admin (saat pertama kali login)
ADMIN_DEFAULT_PASSWORD=Admin1234!

# Anthropic API Key — bisa juga diset langsung dari panel admin backoffice
ANTHROPIC_API_KEY=sk-ant-api03-...

# Telegram Bot (fitur Telegram Bot admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Push Notification Blast — dikirim lewat Expo Push Service (relay ke FCM/APNs)
# Opsional: hanya diperlukan jika project Expo mengaktifkan "Enhanced Security" untuk push.
# Lihat: https://docs.expo.dev/push-notifications/sending-notifications/#additional-security
EXPO_ACCESS_TOKEN=

# Melindungi endpoint /api/cron/send-scheduled-blasts dari akses publik.
# Vercel Cron otomatis mengirim header ini saat CRON_SECRET diset di project settings.
CRON_SECRET=

# URL publik aplikasi — dipakai untuk membangun link (verifikasi email, deep
# link Telegram, dll). Default ke https://gizku.com bila tidak diset.
# Untuk environment staging, set ke https://staging.gizku.com.
NEXT_PUBLIC_APP_URL=https://gizku.com

# Google Analytics 4 — Measurement ID dari GA4 property (Admin > Data Streams >
# Web stream). Kosongkan untuk mematikan GA sepenuhnya (dev lokal, misalnya).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Resend — pengiriman email verifikasi (register & ganti email).
# Setup: resend.com > Domains > tambahkan & verifikasi domain gizku.com (DNS
# SPF/DKIM/DMARC) > API Keys > buat key dengan scope "Sending access".
# Sender terdaftar di kode sebagai no-reply@gizku.com (lib/email.ts) — pastikan
# domain-nya (bukan alamat email spesifik) yang diverifikasi di Resend.
RESEND_API_KEY=re_...

# Resend Inbound — terima keluhan/laporan user via email, masuk otomatis ke
# /admin/reports. 1 domain (plan gratis Resend cuma boleh 1 domain, jadi
# staging TIDAK pakai domain/subdomain terpisah) — production & staging
# dibedakan lewat ALAMAT-nya saja, di bawah domain gizku.com yang sama.
# Setup:
#   1. resend.com > Emails > Receiving > enable untuk domain gizku.com (MX
#      record dari Resend, tambahkan sekali ke DNS gizku.com).
#   2. resend.com > Webhooks > buat 2 webhook terpisah, sama-sama event
#      "email.received" (boleh lebih dari 1 webhook per akun):
#        - endpoint https://gizku.com/api/webhooks/resend-inbound
#          (deployment production)
#        - endpoint https://staging.gizku.com/api/webhooks/resend-inbound
#          (deployment staging)
#      Tiap webhook dapat signing secret sendiri.
# Karena cuma 1 domain, webhook fan-out ke SEMUA alamat @gizku.com ke KEDUA
# endpoint (bukan per-alamat) — makanya SUPPORT_INBOUND_EMAIL di bawah wajib
# beda per environment, itu yang jadi filter: deployment production hanya
# proses email ke support@gizku.com, staging hanya ke
# support-staging@gizku.com; selain itu diabaikan (di-ack 200, tidak
# disimpan). JANGAN pakai alamat yang sama di kedua environment.
RESEND_INBOUND_WEBHOOK_SECRET=whsec_...
SUPPORT_INBOUND_EMAIL=support@gizku.com
# Di environment staging, override jadi: SUPPORT_INBOUND_EMAIL=support-staging@gizku.com
